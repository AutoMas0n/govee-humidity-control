[Unit]
Description=Govee H5080 humidity control daemon (local BLE, no cloud)
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
# E245 = dehumidifier plug; 40A4 = H5179 humidity sensor.
# Plug takes ~10 s to appear; the daemon retries reads internally.
ExecStart=/home/pi/Github/govee-humidity-control/govee-ble/target/release/govee-ble daemon \
  --plug-mac D4:AD:FC:42:E2:45 \
  --plug-skey f6e0730a5be545e3 \
  --sensor-mac E3:32:81:12:40:A4 \
  --interval 60 \
  --threshold 60 \
  --hc-url https://hc-ping.com/your-id
WorkingDirectory=/home/pi/Github/govee-humidity-control/govee-ble
User=root
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target