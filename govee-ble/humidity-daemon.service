[Unit]
Description=Govee H5080 humidity control daemon (local BLE, no cloud)
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
# E1DD = dehumidifier plug; 40A4 = H5179 humidity sensor.
# Plug takes ~10 s to appear; the daemon retries reads internally.
# Status page: http://<pi-ip>:8080/ (humidity/temp/battery/plug/ts).
ExecStart=/home/pi/Github/govee-humidity-control/govee-ble/target/release/govee-ble daemon \
  --plug-mac D4:AD:FC:41:E1:DD \
  --plug-skey a69f370afd964e0d \
  --sensor-mac E3:32:81:12:40:A4 \
  --interval 900 \
  --hi 55 \
  --lo 45 \
  --status-port 8080
WorkingDirectory=/home/pi/Github/govee-humidity-control/govee-ble
# env_logger silences everything below `error` unless RUST_LOG overrides it.
Environment=RUST_LOG=info
User=root
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target